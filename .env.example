# AI Sales Pipeline - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials

# =============================================================================
# REQUIRED: Anthropic API Key
# =============================================================================
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# Agent Manager Configuration
# =============================================================================
MAX_CONCURRENT_TASKS=5
RATE_LIMIT_PER_MINUTE=50
DEFAULT_MODEL=claude-sonnet-4-5-20250929
DEFAULT_MAX_TOKENS=4096
DEFAULT_TEMPERATURE=1.0

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=agent_manager.log

# =============================================================================
# Flask Dashboard (if using web dashboard)
# =============================================================================
# IMPORTANT: Generate a secure random key for production
# Example: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=generate-a-secure-random-key-here

# =============================================================================
# Email Integration (optional - for automated outreach)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=sales@yourcompany.com
FROM_NAME=Your Sales Team

# =============================================================================
# CRM Integration (optional)
# =============================================================================
# Choose your CRM: salesforce, hubspot, pipedrive
CRM_TYPE=salesforce
CRM_API_KEY=your-crm-api-key-here
CRM_BASE_URL=https://your-instance.salesforce.com

# =============================================================================
# Lead Enrichment APIs (optional)
# =============================================================================
# Apollo.io
APOLLO_API_KEY=your-apollo-api-key-here

# LinkedIn Sales Navigator
LINKEDIN_API_KEY=your-linkedin-api-key-here

# Google Maps (for address/location data)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# =============================================================================
# Portal Automation (optional - for serviceability checks)
# =============================================================================
PORTAL_USERNAME=your-portal-username
PORTAL_PASSWORD=your-portal-password
PORTAL_URL=https://business.comcast.com

# =============================================================================
# Security Best Practices
# =============================================================================
# 1. Never commit this file with real values to version control
# 2. Use different keys for development, staging, and production
# 3. Rotate credentials regularly (every 90 days minimum)
# 4. Use least-privilege access for all API keys
# 5. Monitor API usage for anomalies
# 6. Store production secrets in a secure vault (AWS Secrets Manager, etc.)
