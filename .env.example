# ==========================================================================
# AI Sales Pipeline - Environment Configuration Template
# ==========================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to git (already in .gitignore)
# ==========================================================================

# ---- Required: Anthropic API ----
# Get your API key from: https://console.anthropic.com/
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ---- Optional: Agent Performance Settings ----
# Maximum number of concurrent agent tasks
MAX_CONCURRENT_TASKS=5

# API rate limit (requests per minute)
RATE_LIMIT_PER_MINUTE=50

# Claude model to use
DEFAULT_MODEL=claude-sonnet-4-5-20250929

# Max tokens per request
DEFAULT_MAX_TOKENS=4096

# Temperature (0.0-2.0)
DEFAULT_TEMPERATURE=1.0

# ---- Optional: Logging ----
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE=agent_manager.log

# ---- Optional: Portal Credentials (for serviceability checking) ----
# Only needed if using real portal automation
# IMPORTANT: Only use authorized credentials you have legitimate access to
PORTAL_USERNAME=your_authorized_username
PORTAL_PASSWORD=your_password

# ---- Optional: Data Integration APIs ----
# LinkedIn Sales Navigator API (if using)
LINKEDIN_API_KEY=your_linkedin_api_key
LINKEDIN_API_SECRET=your_linkedin_api_secret

# Apollo.io API (if using)
APOLLO_API_KEY=your_apollo_api_key

# Google Maps/Geocoding API (if using)
# Get from: https://console.cloud.google.com/apis/credentials
# NEVER commit real API keys - always use environment variables
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ---- Optional: CRM Integration ----
# Salesforce (if using)
SALESFORCE_USERNAME=your_salesforce_username
SALESFORCE_PASSWORD=your_salesforce_password
SALESFORCE_SECURITY_TOKEN=your_security_token

# HubSpot (if using)
HUBSPOT_API_KEY=your_hubspot_api_key

# ---- Optional: Email/Communication ----
# SMTP settings for outreach automation
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password

# ==========================================================================
# Security Reminders
# ==========================================================================
# 1. NEVER commit this file with real values
# 2. Keep production credentials separate from development
# 3. Rotate API keys regularly
# 4. Use different keys for different environments (dev/staging/prod)
# 5. Monitor API usage for unauthorized access
# 6. Revoke and rotate immediately if a key is exposed
